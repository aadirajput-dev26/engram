# =============================================================================
# AI Document Intelligence / RAG Microservice — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values. NEVER commit .env with secrets.
# See docs/19_ENVIRONMENT_VARIABLES.md for full documentation.
# =============================================================================

# --- 1. Service Identity ---
JWT_SECRET_KEY=engram_jwt_secret_key_change_in_production_998877665544332211
SERVICE_ENV=local
AI_SERVICE_API_KEY=your_service_api_key_here
AI_SCOPE_TOKEN_SECRET=your_scope_token_signing_secret_here
AI_SCOPE_TOKEN_TTL_SECONDS=120

# --- 2. Database ---
AI_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_ai

# --- 3. Object Storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
# For S3-compatible storage:
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
# OBJECT_STORAGE_REGION=

# --- 4. Vector Database ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=rag_chunks

# --- 5. LLM Provider ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL_NAME=gpt-4o-mini
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1
LLM_REQUEST_TIMEOUT_SECONDS=60

# --- 6. Embeddings & Reranking ---
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBEDDING_BATCH_SIZE=32
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

# --- 7. OCR / Document Processing ---
OCR_ENGINE=paddleocr
OCR_RENDER_DPI=200
MAX_UPLOAD_SIZE_MB=50
PAGE_BATCH_SIZE=10
MAX_STAGE_RETRY_COUNT=3

# --- 8. PageIndex ---
PAGEINDEX_MODE=local
PAGEINDEX_API_KEY=
PAGEINDEX_MODEL_NAME=gpt-4o-mini
PAGEINDEX_STORAGE_PATH=.pageindex

# --- 9. Retrieval Tuning ---
RETRIEVAL_TOP_N_SEMANTIC=30
RETRIEVAL_TOP_N_KEYWORD=30
RETRIEVAL_TOP_M_FUSED=40
RETRIEVAL_TOP_K_FINAL=10
RRF_K_CONSTANT=60

# --- 10. Topic Analysis ---
TOPIC_MODEL_BACKEND=lda
TOPIC_ASYNC_THRESHOLD_DOCS=20

# --- 11. Job Queue / Workers ---
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_CONCURRENCY=2
